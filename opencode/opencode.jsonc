{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugins": [],
  "agents": {
    "explore": {
      "model": "opencode-go/mimo-v2.6-flash",
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },
    "general": {
      "model": "opencode-go/minimax-m3"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp"
        ]
      }
    }
  }
}
