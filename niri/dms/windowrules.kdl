// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1786013142196961269 @name=kicad
window-rule {
    match app-id="^kicad$" title="Schematic"
    match app-id="^kicad$" title="PCB\\sEditor"
    match app-id="^kicad$" title="Symbol\\sEditor"
    match app-id="^kicad$" title="Footprint\\sEditor"
    default-column-width { proportion 0.9; }
}

// @id=wr_1786087737170412873 @name=zen
window-rule {
    match app-id="^zen$"
    default-column-width { proportion 0.9; }
}

// @id=wr_1786090885699473164 @name=kicad
window-rule {
    match app-id="^kicad$" title="Chooser"
    default-column-width { fixed 1200; }
    default-window-height { fixed 800; }
}

// @id=wr_1786102117836631937 @name=bf_config_app
window-rule {
    match app-id="^bf_config_app$"
    default-column-width { proportion 0.8; }
}

// @id=wr_1786358455744408626 @name=ONLYOFFICE
window-rule {
    match app-id="^ONLYOFFICE$"
    default-column-width { proportion 0.8; }
}

// @id=wr_1786523058355112251 @name=STM32CubeIDE
window-rule {
    match app-id="^STM32CubeIDE$"
    default-column-width { proportion 0.9; }
}

// @id=wr_1786689468365624789 @name=codium
window-rule {
    match app-id="^codium$"
    default-column-width { proportion 0.9; }
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
